OPENAI_API_KEY=sk-...
TRANSCRIPTIONS_DIR=transcriptions
# Optional: set this only if a PulseAudio server must be specified
PULSE_SERVER=
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
ALT_TRANSCRIPTION_MODEL=gpt-4o-transcribe
CLEANUP_MODEL=gpt-4.1-mini
CLEANUP_ENABLED=false
# Optional: same value as OPENAI_API_KEY; enables the opt-in real-provider smokes (ruling 19)
HERE_PROVIDER_SMOKE_KEY=
